# Copy to .env (never commit .env). Every variable below is read by apps/api/src/config/env.ts (loadEnv) or by prisma/seed.ts.
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5434/smart_dev
# >= 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
PUBLIC_API_URL=http://localhost:4100
# Throttling and lockout (defaults shown)
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Demo seed only (read by prisma/seed.ts, never use in production)
SEED_DEMO_PASSWORD=CHANGE_ME_demo_password
# Tests only (database name must contain "test"; it is wiped by every test run)
TEST_DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5434/smart_test
# Payment providers: interfaces only until merchant keys exist (leave empty = provider disabled)
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
STRIPE_SECRET_KEY=
# Push notifications: needs a Firebase project (leave empty)
FCM_SERVICE_ACCOUNT_JSON=
